# Secrets and credentials
*.env
.env
.env.*
!*.env.example
*.key
*.pem
*.secret

# Private memory and databases
memory/*.db
memory/*.sqlite
memory/*.sqlite3

# AI model files
*.gguf
*.bin
*.safetensors
*.pt
*.pth

# Python temporary files
__pycache__/
*.pyc
*.pyo

# Logs and temporary files
logs/*
*.log
*.tmp

# Backups
backups/*

# Private configuration; keep example templates in Git.
/config/*
!/config/*.example.json
!/config/*.sql
/config/*.env
!/config/*.env.example

# Third-party AI engine
/engine/llama.cpp/

# Android build outputs and private signing material
android-companion/*.jks
android-companion/*.keystore
android-companion/**/*.jks
android-companion/**/*.keystore
android-companion/local.properties
android-companion/**/local.properties
android-companion/.gradle/
android-companion/**/.gradle/
android-companion/build/
android-companion/**/build/

# OpenCode runtime files
.opencode/node_modules/
.opencode/package.json
.opencode/package-lock.json
.opencode/bun.lock

# Old code backups
*.bak
*.backup
*.backup*
*.before-*
